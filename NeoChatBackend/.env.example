OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-4o-mini"
SITE_URL="http://localhost:3000"
SITE_NAME="NeoChat"

# Payment Gateway (Future integration)
PAYMENT_GATEWAY_URL=""
